# GITHUB_CLIENT_ID: Public OAuth App / GitHub App Client ID for GitHub OAuth Device Flow & PKCE.
# Register a GitHub OAuth App (with Device Flow enabled) or GitHub App and set this in the AI Studio Secrets panel.
# No GitHub client secret or password is ever required.
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID

# GOOGLE_WEB_CLIENT_ID: Optional OAuth 2.0 Web Client ID for Android Credential Manager Google Sign-In.
# Set this in the AI Studio Secrets panel to enable native one-tap Google account connection.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
